# API. Bind to all interfaces when this service runs on a private container network.
BIND_ADDR=0.0.0.0:3001

# PostgreSQL. Matches compose.yaml.
DATABASE_URL=postgres://app:app@127.0.0.1:5432/app
DATABASE_MAX_CONNECTIONS=5

# Firebase Admin Auth
FIREBASE_PROJECT_ID=your-firebase-project-id

# Production: paste the complete service-account JSON as one server-only value.
# Prefer setting this through your deployment secret manager, not a checked-in file.
# In a local .env file, wrap the compact JSON in single quotes so dotenv keeps it intact.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
FIREBASE_SERVICE_ACCOUNT_JSON=

# The local startup script sets this automatically. It intentionally omits the protocol.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
