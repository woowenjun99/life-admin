#!/bin/sh

set -eu

/usr/local/bin/start-clamav &
scanner_pid=$!

cleanup() {
  kill "$scanner_pid" 2>/dev/null || true
  wait "$scanner_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

attempt=0
until printf 'zPING\0' | nc -w 1 127.0.0.1 3310 | tr -d '\000' | grep -qx 'PONG'; do
  attempt=$((attempt + 1))
  if [ "$attempt" -ge 120 ]; then
    echo "ClamAV did not answer zPING within 60 seconds." >&2
    exit 1
  fi
  if ! kill -0 "$scanner_pid" 2>/dev/null; then
    wait "$scanner_pid" || true
    echo "ClamAV exited before it became ready." >&2
    exit 1
  fi
  sleep 0.5
done

exec runuser -u app -- /usr/local/bin/backend
