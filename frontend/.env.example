# Firebase Web App configuration. Copy these values from Firebase project settings.
# These are public browser identifiers, not server credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Console → Project settings → Cloud Messaging → Web Push certificates.
# This is public browser configuration; never put a server credential here.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Optional local Firebase Auth Emulator URL.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
